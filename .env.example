# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/corpflow

# API server
PORT=3000
NODE_ENV=development

# Shared only with the trusted JWT issuer. Use at least 32 random bytes.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=corpflow-auth
JWT_AUDIENCE=corpflow-api
